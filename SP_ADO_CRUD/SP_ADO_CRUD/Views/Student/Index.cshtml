@model List<Student>

@{
    ViewData["Title"] = "Students";
}


<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">Student List</h3>
        <a href="/Student/Create" class="btn btn-primary">
            + Add Student
        </a>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Photo</th>
                            <th>Name</th>
                            <th>Gender</th>
                            <th>Qualification</th>
                            <th>Technologies</th>
                            <th>DOB</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            int count = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@count</td>

                                    <!-- Image -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            <img src="@item.ImagePath"
                                                 class="rounded-circle"
                                                 style="width:50px; height:50px; object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">No Image</span>
                                        }
                                    </td>

                                    <!-- Name -->
                                    <td class="fw-semibold">@item.Name</td>

                                    <!-- Gender -->
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.Gender
                                        </span>
                                    </td>

                                    <!-- Qualification -->
                                    <td>@item.QualificationId</td>

                                    <!-- Technologies -->
                                    <td>
                                        @foreach (var tech in item.Technologies?.Split(',') ?? new string[] { })
                                        {
                                            <span class="badge bg-secondary me-1">@tech</span>
                                        }
                                    </td>

                                    <!-- DOB -->
                                    <td>
                                        @item.DOB
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center">
                                        <a href="/Student/Edit/@item.Id" class="btn btn-sm btn-warning me-1">
                                            Edit
                                        </a>

                                        <a href="/Student/Delete/@item.Id"
                                           class="btn btn-sm btn-danger"
                                           onclick="return confirm('Are you sure to delete?')">
                                            Delete
                                        </a>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">
                                    No records found
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>