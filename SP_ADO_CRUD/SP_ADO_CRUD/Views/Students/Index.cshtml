@model IEnumerable<SP_ADO_CRUD.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gender)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.QualificationName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Technologies)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImagePath)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Gender)
            </td>
 
            <td>
                @Html.DisplayFor(modelItem => item.QualificationName)
            </td>
            <td>    
                @Html.DisplayFor(modelItem => item.Technologies)
            </td>
                <td>
                    @* <img src="/images/@item.ImagePath" width="70" /> *@
                    @{
                        string ext = System.IO.Path.GetExtension(item.ImagePath).ToLower();
                    }

                    @if (ext == ".jpg" || ext == ".png")
                    {
                        <img src="/images/@item.ImagePath" width="80" />
                    }
                    else
                    {
                        <a href="/images/@item.ImagePath" target="_blank">View File</a>
                    }
                </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id=item.Id }) |
                @Html.ActionLink("Details", "Details", new { id=item.Id }) |
                @Html.ActionLink("Delete", "Delete", new { id=item.Id  })
            </td>
        </tr>
}
    </tbody>
</table>
