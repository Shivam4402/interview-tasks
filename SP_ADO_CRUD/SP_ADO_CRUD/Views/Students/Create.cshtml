@model SP_ADO_CRUD.Models.Student

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Student</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="All" class="text-danger"></div>

            <!-- Name -->
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Gender -->
            <div class="form-group mb-3">
                <label asp-for="Gender" class="control-label"></label>
                <br />

                <input asp-for="Gender" type="radio" value="Male" /> Male
                <input asp-for="Gender" type="radio" value="Female" /> Female

                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <!-- Qualification -->
            <div class="form-group mb-3">
                <label asp-for="QualificationId" class="control-label"></label>

                <select asp-for="QualificationId"
                        asp-items="@(new SelectList(ViewBag.Qualifications, "QualificationId", "QualificationName"))"
                        class="form-control">
                </select>

                <span asp-validation-for="QualificationId" class="text-danger"></span>
            </div>

            <!-- Technologies -->
            <div class="form-group mb-3">
                <label asp-for="Technologies" class="control-label"></label>
                <br />

                <input type="checkbox" name="Technologies" value="C#" /> C#
                <input type="checkbox" name="Technologies" value=".NET" /> .NET
                <input type="checkbox" name="Technologies" value="SQL" /> SQL

                <span asp-validation-for="Technologies" class="text-danger"></span>
            </div>

            <!-- File Upload -->
            <div class="form-group mb-3">
                <label class="control-label">Upload Image</label>
                <input type="file" name="ImageFile" class="form-control" />
                <span asp-validation-for="ImagePath" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}