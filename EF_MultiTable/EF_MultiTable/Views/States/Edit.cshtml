@using EF_MultiTable.ViewModels
@model StateCityVM


<h2>Edit State</h2>

<form asp-action="Edit" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <!-- Hidden StateId -->     
    <input type="hidden" asp-for="StateId" />

    <!-- State Name -->
    <div class="mb-3">
        <label>State Name</label>
        <input type="text" asp-for="StateName" class="form-control" />
        <span asp-validation-for="StateName" class="text-danger"></span>

    </div>

    <!-- Cities Table -->
    <table class="table" id="cityTable">
        <thead>
            <tr>
                <th>City Name</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>

            @for (int i = 0; i < Model.Cities.Count; i++)
            {
                <tr>
                    <td>
                        <!-- Hidden CityId (IMPORTANT) -->
                        <input type="hidden" asp-for="Cities[i].CityId" />

                        <input type="text" asp-for="Cities[i].CityName" class="form-control" />
                        <span asp-validation-for="Cities[i].CityName" class="text-danger"></span>

                    </td>
                    <td>
                        <button type="button" class="btn btn-danger removeRow">Remove</button>
                    </td>
                </tr>
            }

        </tbody>
    </table>

    <button type="button" id="addRow" class="btn btn-success">Add City</button>

    <br /><br />

    <button type="submit" class="btn btn-primary">Update</button>

    <a asp-action="Index" class="btn btn-secondary">Back</a>

</form>


<script>
    let index = @Model.Cities.Count;

    // ADD ROW
    document.getElementById("addRow").addEventListener("click", function () {

        let row = `
        <tr>
            <td>
                <input type="hidden" name="Cities[${index}].CityId" value="0" />
                <input type="text" name="Cities[${index}].CityName" class="form-control" />
            </td>
            <td>
                <button type="button" class="btn btn-danger removeRow">Remove</button>
            </td>
        </tr>`;

        document.querySelector("#cityTable tbody").insertAdjacentHTML("beforeend", row);
        index++;
    });

    // REMOVE ROW
    document.addEventListener("click", function (e) {
        if (e.target.classList.contains("removeRow")) {
            e.target.closest("tr").remove();
        }
    });
</script>