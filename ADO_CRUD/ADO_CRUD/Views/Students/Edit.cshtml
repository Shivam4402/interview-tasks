@model ADO_CRUD.Models.StudentEditVM

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Student</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>

            <input asp-for="StudentId" type="hidden" />
            <input type="hidden" asp-for="ExistingImagePath" />
            
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gender" class="control-label"></label>

                <input asp-for="Gender" type="radio" value="Male" /> Male
                <input asp-for="Gender" type="radio" value="Female" /> Female

                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DOB" class="control-label"></label>
                <input asp-for="DOB" type="date" class="form-control" />
                <span asp-validation-for="DOB" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="QualificationId" class="control-label"></label>

                <select asp-for="QualificationId"
                        asp-items="@(new SelectList(ViewBag.Qualifications, "QualificationId", "QualificationName"))"
                        class="form-control">
                </select>

                <span asp-validation-for="QualificationId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Technologies" class="control-label"></label>

                @{
                    var techs = Model.Technologies;
                }

                <input type="checkbox" name="Technologies" value="C#"
                @(techs != null && techs.Contains("C#") ? "checked" : "") /> C#

                <input type="checkbox" name="Technologies" value=".NET"
                @(techs != null && techs.Contains(".NET") ? "checked" : "") /> .NET

                <input type="checkbox" name="Technologies" value="SQL"
                @(techs != null && techs.Contains("SQL") ? "checked" : "") /> SQL

                <span asp-validation-for="Technologies" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Current Image</label>
                <br />
                @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                {
                    <img src="~/images/@Model.ExistingImagePath" width="80" />
                }
                <br /><br />

                <label class="control-label">Upload New Image</label>
                <input type="file" name="ImageFile" class="form-control" />

                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back</a>

            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
