<div class="container mt-4">

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Student Form</h5>
        </div>

        <div class="card-body">

            <input type="hidden" id="studentId" />

            <div class="row g-3">

                <!-- Name -->
                <div class="col-md-6">
                    <label class="form-label">Name</label>
                    <input type="text" id="name" class="form-control" placeholder="Enter name">
                </div>

                <!-- Email -->
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input type="text" id="email" class="form-control" placeholder="Enter email">
                </div>

                <!-- Gender -->
                <div class="col-md-6">
                    <label class="form-label d-block">Gender</label>

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="gender" value="Male">
                        <label class="form-check-label">Male</label>
                    </div>

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="gender" value="Female">
                        <label class="form-check-label">Female</label>
                    </div>
                </div>

                <!-- DOB -->
                <div class="col-md-6">
                    <label class="form-label">DOB</label>
                    <input type="date" id="dob" class="form-control">
                </div>

                <!-- State -->
                <div class="col-md-6">
                    <label class="form-label">State</label>
                    <select id="state" class="form-select"></select>
                </div>

                <!-- City -->
                <div class="col-md-6">
                    <label class="form-label">City</label>
                    <select id="city" class="form-select"></select>
                </div>

                <!-- Technologies -->
                <div class="col-md-12">
                    <label class="form-label d-block">Technologies</label>

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" value="C#">
                        <label class="form-check-label">C#</label>
                    </div>

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" value="Java">
                        <label class="form-check-label">Java</label>
                    </div>

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" value="JS">
                        <label class="form-check-label">JavaScript</label>
                    </div>
                </div>

                <!-- Image Upload -->
                <div class="col-md-6">
                    <label class="form-label">Profile Image</label>
                    <input type="file" id="image" class="form-control">
                </div>

                <!-- Preview -->
                <div class="col-md-6 text-center" style="display:none;" id="imgdv">
                    <label class="form-label d-block">Preview</label>
                    <img id="imgPreview" class="img-thumbnail" width="100" />
                </div>

                <!-- Buttons -->
                <div class="col-12 text-end mt-3">
                    <button class="btn btn-success me-2" onclick="AddStudent()" id="btnsubmit">
                        Submit
                    </button>

                    <button class="btn btn-warning" onclick="UpdateStudent()" id="btnupdate" style="display:none;">
                        Update
                    </button>
                    
                    <button class="btn btn-danger" onclick="ClearForm()">
                        Clear
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- TABLE -->

    <div class="card shadow mt-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Student List</h5>
        </div>

        <div class="card-body table-responsive">

            <table class="table table-bordered table-hover align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Gender</th>
                        <th>Technologies</th>
                        <th>State</th>
                        <th>City</th>
                        <th>DOB</th>
                        <th>Image</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="tbldata"></tbody>
            </table>

        </div>
    </div>

</div>

@section scripts{
    @* <script src="~/js/Student.js"></script> *@

    <script>

        const LoadStates = async () => {
            const res = await fetch('/Student/GetStates');
            const data = await res.json();

            let opt = `<option value="${0}">Select</option>`;
            data.forEach(s => {
                opt += `<option value="${s.stateId}">${s.stateName}</option>`;
            });

            document.getElementById("state").innerHTML = opt;
        };


        LoadStates();


        document.getElementById("state").addEventListener("change", async function () {

            const stateId = this.value;

            const res = await fetch('/Student/GetCities?stateId=' + stateId);
            const data = await res.json();

            let opt = `<option value="${0}">Select</option>`;
            data.forEach(c => {
                opt += `<option value="${c.cityId}">${c.cityName}</option>`;
            });

            document.getElementById("city").innerHTML = opt;
        });


        function getTechnologies() {
            let tech = [];
            document.querySelectorAll("input[type=checkbox]:checked").forEach(x => {
                tech.push(x.value);
            });
            return tech.join(",");
        }


        function validateForm() {

            let name = document.getElementById("name").value.trim();
            let email = document.getElementById("email").value.trim();
            let dob = document.getElementById("dob").value;

            let gender = document.querySelector('input[name="gender"]:checked');

            let state = document.getElementById("state").value;
            let city = document.getElementById("city").value;

            let tech = document.querySelectorAll("input[type=checkbox]:checked");

            let file = document.getElementById("image").files[0];



            // NAME
            if (name === "") {
                alert("Name is required");
                return false;
            }

            // EMAIL
            if (email === "") {
                alert("Email is required");
                return false;
            }

            // GENDER
            if (!gender) {
                alert("Select gender");
                return false;
            }

            // DOB
            if (!dob) {
                alert("Select DOB");
                return false;
            }

            // STATE
            if (state == "" || state == "Select") {
                alert("Select State");
                return false;
            }

            // CITY
            if (!city) {
                alert("Select City");
                return false;
            }

            // TECHNOLOGY
            if (tech.length === 0) {
                alert("Select at least one technology");
                return false;
            }

            
            if (file) {
                const allowedTypes = /image\/(jpeg|jpg|png|webp)/;

                if (!allowedTypes.test(file.type)) {
                    alert("Only JPG, PNG, WEBP allowed");
                    return false;
                }

                if (file.size > 2 * 1024 * 1024) {
                    alert("Max 2MB allowed");
                    return false;
                }
            }

            return true;
}


        const AddStudent = async () => {

            if (!validateForm()) return;

            let formData = new FormData();

            formData.append("Name", document.getElementById("name").value);
            formData.append("Email", document.getElementById("email").value);
            formData.append("Dob", document.getElementById("dob").value);
            formData.append("StateId", document.getElementById("state").value);
            formData.append("CityId", document.getElementById("city").value);
            formData.append("Technologies", getTechnologies());
                
            // Radio
            let gender = document.querySelector('input[name="gender"]:checked')?.value;
            formData.append("Gender", gender);

            // Image
            let file = document.getElementById("image").files[0];
            formData.append("ProfileImage", file);

            await fetch('/Student/AddStudent', {
                method: "POST",
                body: formData
            });

            alert("Saved");
            FetchStudents();
        };


        const FetchStudents = async () => {

            const res = await fetch('/Student/GetAllStudents');
            const data = await res.json();

            let row = "";

            data.forEach(s => {
                row += `<tr>
                    <td>${s.name}</td>
                    <td>${s.gender}</td>
                    <td>${s.technologies}</td>
                    <td>${s.stateName}</td>
                    <td>${s.cityName}</td>
                    <td>${s.dob?.split('T')[0]}</td>
                    <td><img src="/images/${s.profileImage}" width="50"/></td>
                    <td>
                        <button onclick="EditStudent(${s.id})">Edit</button>
                        <button onclick="DeleteStudent(${s.id})">Delete</button>

                    </td>
                </tr>`;
            });

            document.getElementById("tbldata").innerHTML = row;
        };


        FetchStudents();


        const EditStudent = async (id) => {

            const res = await fetch('/Student/GetStudentById?id=' + id);
            const st = await res.json();

            // SET BASIC FIELDS
            document.getElementById("studentId").value = st.id;
            document.getElementById("name").value = st.name;
            document.getElementById("email").value = st.email;
            document.getElementById("dob").value = st.dob?.split('T')[0];

            // ✅ RADIO AUTO SELECT
            document.querySelectorAll('input[name="gender"]').forEach(r => {
                r.checked = (r.value === st.gender);
            });

            // ✅ STATE DROPDOWN
            document.getElementById("state").value = st.stateId;

            // LOAD CITIES FIRST (IMPORTANT)
            await LoadCitiesForEdit(st.stateId, st.cityId);

            // ✅ CHECKBOX AUTO SELECT
            let techArray = st.technologies?.split(',') || [];

            document.querySelectorAll("input[type=checkbox]").forEach(c => {
                c.checked = techArray.includes(c.value);
            });

            // OPTIONAL: SHOW IMAGE PREVIEW
            if (st.profileImage) {
                document.getElementById("imgPreview").src = "/images/" + st.profileImage;
            }

            // SWITCH BUTTON
            document.getElementById("btnsubmit").style.display = "none";
            document.getElementById("btnupdate").style.display = "inline-block";
            document.getElementById("imgdv").style.display = "inline-block";
        };


        const LoadCitiesForEdit = async (stateId, selectedCityId) => {

            const res = await fetch('/Student/GetCities?stateId=' + stateId);
            const data = await res.json();

            let opt = "";
            data.forEach(c => {
                opt += `<option value="${c.cityId}" ${c.cityId == selectedCityId ? "selected" : ""}>
                            ${c.cityName}
                        </option>`;
            });

            document.getElementById("city").innerHTML = opt;
        };


        const UpdateStudent = async () => {

            let formData = new FormData();

            formData.append("Id", document.getElementById("studentId").value);
            formData.append("Name", document.getElementById("name").value);
            formData.append("Email", document.getElementById("email").value);
            formData.append("DOB", document.getElementById("dob").value);
            formData.append("StateId", document.getElementById("state").value);
            formData.append("CityId", document.getElementById("city").value);

            // RADIO
            let gender = document.querySelector('input[name="gender"]:checked')?.value;
            formData.append("Gender", gender);

            // CHECKBOX
            formData.append("Technologies", getTechnologies());

            // IMAGE (optional)
            let file = document.getElementById("image").files[0];
            if (file) {
                formData.append("ProfileImage", file);
            }

            await fetch('/Student/UpdateStudent', {
                method: "POST",
                body: formData
            });

            alert("Updated Successfully");

            ClearForm();
            FetchStudents();
        };


        const ClearForm = () => {

            document.getElementById("studentId").value = "";
            document.getElementById("name").value = "";
            document.getElementById("email").value = "";
            document.getElementById("dob").value = "";

            document.querySelectorAll('input[name="gender"]').forEach(r => r.checked = false);

            document.querySelectorAll("input[type=checkbox]").forEach(c => c.checked = false);

            document.getElementById("state").value = "";
            document.getElementById("city").innerHTML = "";

            document.getElementById("image").value = "";

            document.getElementById("btnsubmit").style.display = "inline-block";
            document.getElementById("btnupdate").style.display = "none";
            document.getElementById("imgdv").style.display = "none";

        };


        const DeleteStudent = async (id) => {

            const isConfirmed = confirm("Really want to delete?");

            if (!isConfirmed) return; // ✅ stop if user cancels

            await fetch('/Student/DeleteStudent?id=' + id, {
                method: "POST"
            });

            alert("Deleted successfully"); // optional
            FetchStudents();
        };

    </script>
}